#!/usr/bin/env python3
"""Per-session usage view for the OpenAI Codex CLI — the codex analogue of
~/bin/claude-usage.

Codex writes one rollout transcript per session under
$CODEX_HOME/sessions/YYYY/MM/DD/rollout-<ts>-<UUID>.jsonl. Every assistant turn
emits an `event_msg` of type `token_count` that records BOTH:
  * per-turn token usage (`info.last_token_usage`: input / cached_input / output /
    reasoning_output / total), and
  * the live account rate-limit meter (`rate_limits.primary` = the 5-hour /
    300-minute window, `rate_limits.secondary` = the weekly / 10080-minute
    window), each with `used_percent` and `resets_at`, plus `plan_type`.

So unlike claude-usage (which has to calibrate the 5h ceiling), this reads the
REAL quota percentage straight from the data. It shows that headline meter, then
breaks down per-session/project token consumption so you can see which open
Codex session is eating the most — subagent threads are rolled into the parent
that spawned them.

Usage:
  codex-usage                 # quota meter + sessions active in the last 24h
  codex-usage --window 5h     # attribute over the 5h quota window (or 7d, 2d, total)
  codex-usage --all           # every session ever
  codex-usage --top N         # rows to show (default 20)
  codex-usage --by-project    # aggregate by project dir instead of per session
  codex-usage --api-cost      # show USD at OpenAI API list prices instead of tokens
"""

import argparse
import json
import os
from datetime import datetime, timezone, timedelta
from glob import glob

CODEX_HOME = os.environ.get("CODEX_HOME", os.path.expanduser("~/.codex"))
SESSIONS = os.path.join(CODEX_HOME, "sessions")

# OpenAI API list price, USD per token, for the --api-cost estimate (what the
# usage WOULD cost billed pay-as-you-go; on a Codex subscription you are not
# actually charged this). Keyed by model-name substring; unknown -> gpt-5.5.
#   gpt-5.5: $5/1M input, $0.50/1M cached input, $30/1M output  (output incl. reasoning)
PRICING = {
    "gpt-5.5": dict(inp=5e-6, cached=0.5e-6, out=30e-6),
    "gpt-5":   dict(inp=5e-6, cached=0.5e-6, out=30e-6),
}
DEFAULT_PRICE = PRICING["gpt-5.5"]


def price_for(model):
    m = (model or "").lower()
    for k, v in PRICING.items():
        if k in m:
            return v
    return DEFAULT_PRICE


def cost_of(last, model):
    """USD API-list-price estimate for one token_count delta."""
    p = price_for(model)
    din = last.get("input_tokens", 0) or 0
    dcached = last.get("cached_input_tokens", 0) or 0
    dout = last.get("output_tokens", 0) or 0
    return max(0, din - dcached) * p["inp"] + dcached * p["cached"] + dout * p["out"]


def parse_ts(s):
    if not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def short(s, n=46):
    return " ".join((s or "").split())[:n]


def human_age(dt, now):
    if dt is None:
        return "?"
    sec = (now - dt).total_seconds()
    if sec < 90:
        return f"{int(sec)}s"
    if sec < 5400:
        return f"{int(sec//60)}m"
    if sec < 36 * 3600:
        return f"{int(sec//3600)}h"
    return f"{int(sec//86400)}d"


def human_until(epoch, now):
    if not epoch:
        return "?"
    sec = epoch - now.timestamp()
    if sec <= 0:
        return "now"
    if sec < 5400:
        return f"{int(sec//60)}m"
    if sec < 86400:
        return f"{int(sec//3600)}h{int((sec%3600)//60):02d}m"
    return f"{int(sec//86400)}d{int((sec%86400)//3600)}h"


def fmt_tok(x):
    x = int(x)
    if x >= 1_000_000:
        return f"{x/1e6:.1f}M"
    if x >= 1000:
        return f"{x/1e3:.0f}k"
    return str(x)


def fmt_money(x):
    if x >= 1000:
        return f"${x/1000:.1f}k"
    return f"${x:.2f}"


def scan():
    """Return (sessions dict, latest_rate_limits or None, now)."""
    now = datetime.now(timezone.utc)
    S = {}
    latest_rl = None  # (epoch, rate_limits dict)

    files = glob(os.path.join(SESSIONS, "*", "*", "*", "rollout-*.jsonl"))
    for fp in files:
        sid = None
        rec = None
        try:
            fh = open(fp, "r", errors="ignore")
        except OSError:
            continue
        with fh:
            for line in fh:
                if '"type"' not in line:
                    continue
                try:
                    o = json.loads(line)
                except json.JSONDecodeError:
                    continue
                typ = o.get("type")
                p = o.get("payload") or {}
                if typ == "session_meta":
                    sid = p.get("id")
                    if sid is None:
                        continue
                    parent = None
                    if p.get("thread_source") == "subagent":
                        def dig(d, *ks):
                            for k in ks:
                                d = d.get(k) if isinstance(d, dict) else None
                            return d
                        parent = dig(p, "source", "subagent", "thread_spawn", "parent_thread_id") \
                                 or p.get("forked_from_id")
                    rec = S.setdefault(sid, dict(
                        id=sid, cwd=p.get("cwd", ""), parent=parent,
                        is_sub=p.get("thread_source") == "subagent",
                        model=p.get("model_provider", ""), title="",
                        first=None, last=None, turns=0,
                        tok={"5h": 0, "24h": 0, "7d": 0, "total": 0},
                        out={"5h": 0, "24h": 0, "7d": 0, "total": 0},
                        cost={"5h": 0.0, "24h": 0.0, "7d": 0.0, "total": 0.0}))
                    if rec["parent"] is None and parent:
                        rec["parent"] = parent
                    continue
                if rec is None:
                    # transcript without a leading session_meta we parsed; skip
                    continue
                # the actual model (e.g. gpt-5.5) lives in turn_context, not session_meta
                if typ == "turn_context" and p.get("model"):
                    rec["model"] = p["model"]
                    continue
                ts = parse_ts(o.get("timestamp"))
                # title: first real (non-context) user message
                if not rec["title"]:
                    txt = None
                    if typ == "event_msg" and p.get("type") == "user_message":
                        txt = p.get("message") or p.get("text")
                    elif typ == "response_item" and p.get("type") == "message" \
                            and p.get("role") == "user":
                        c = p.get("content")
                        if isinstance(c, list):
                            txt = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
                        elif isinstance(c, str):
                            txt = c
                    if txt and not txt.lstrip().startswith("<"):
                        rec["title"] = short(txt)
                if typ != "event_msg" or p.get("type") != "token_count":
                    continue
                info = p.get("info") or {}
                last = info.get("last_token_usage") or {}
                dtot = last.get("total_tokens", 0) or 0
                dout = last.get("output_tokens", 0) or 0
                dcost = cost_of(last, rec["model"])
                rec["turns"] += 1
                if ts:
                    rec["first"] = ts if rec["first"] is None else min(rec["first"], ts)
                    rec["last"] = ts if rec["last"] is None else max(rec["last"], ts)
                rl = p.get("rate_limits")
                if rl and rl.get("primary") and ts:
                    e = ts.timestamp()
                    if latest_rl is None or e > latest_rl[0]:
                        latest_rl = (e, rl)
                # window buckets
                for w, secs in (("5h", 5 * 3600), ("24h", 86400), ("7d", 7 * 86400)):
                    if ts and (now - ts).total_seconds() <= secs:
                        rec["tok"][w] += dtot
                        rec["out"][w] += dout
                        rec["cost"][w] += dcost
                rec["tok"]["total"] += dtot
                rec["out"]["total"] += dout
                rec["cost"]["total"] += dcost
    return S, latest_rl, now


def root_of(sid, S, _seen=None):
    """Resolve a subagent session to the parent that spawned it (follow chain)."""
    _seen = _seen or set()
    rec = S.get(sid)
    if not rec or not rec.get("parent") or sid in _seen:
        return sid
    _seen.add(sid)
    if rec["parent"] in S:
        return root_of(rec["parent"], S, _seen)
    return rec["parent"]  # parent not scanned -> use its id as the root key


def bar(pct, width=20):
    pct = max(0.0, min(100.0, pct))
    n = int(round(pct / 100 * width))
    return "#" * n + "." * (width - n)


def main():
    ap = argparse.ArgumentParser(description="Per-session Codex usage + real rate-limit meter.")
    ap.add_argument("--window", default="24h", choices=["5h", "24h", "7d", "total"],
                    help="window to attribute session tokens over (default 24h). 5h = the quota window, 7d = the weekly window")
    ap.add_argument("--all", action="store_true", help="show all sessions, no active-window filter")
    ap.add_argument("--top", type=int, default=20, help="max rows (default 20)")
    ap.add_argument("--by-project", action="store_true", help="aggregate by project dir, not per session")
    ap.add_argument("--api-cost", "--dollars", dest="api_cost", action="store_true",
                    help="show what the usage WOULD cost at OpenAI API pay-as-you-go rates "
                         "(USD est.) instead of token counts; you are not billed this on a subscription")
    args = ap.parse_args()

    win_s = None if args.window == "total" else {"5h": 5 * 3600, "24h": 86400, "7d": 7 * 86400}[args.window]

    S, latest_rl, now = scan()
    nowt = now.timestamp()

    # ---- merge subagents into their root session ----
    roots = {}
    for sid, rec in S.items():
        rk = root_of(sid, S)
        r = roots.get(rk)
        if r is None:
            base = S.get(rk, rec)
            r = roots[rk] = dict(id=rk, cwd=base.get("cwd", "") or rec["cwd"],
                                 title=base.get("title", ""), model=base.get("model", ""),
                                 first=None, last=None, turns=0, subs=0,
                                 tok={k: 0 for k in rec["tok"]}, out={k: 0 for k in rec["out"]},
                                 cost={k: 0.0 for k in rec["cost"]})
        if rec["is_sub"] and rk != sid:
            r["subs"] += 1
        r["turns"] += rec["turns"]
        for k in r["tok"]:
            r["tok"][k] += rec["tok"][k]
            r["out"][k] += rec["out"][k]
            r["cost"][k] += rec["cost"][k]
        for f in ("first",):
            if rec[f] and (r[f] is None or rec[f] < r[f]):
                r[f] = rec[f]
        if rec["last"] and (r["last"] is None or rec["last"] > r["last"]):
            r["last"] = rec["last"]
        if not r["title"] and rec["title"]:
            r["title"] = rec["title"]
        if not r["cwd"] and rec["cwd"]:
            r["cwd"] = rec["cwd"]

    # ---- optional project aggregation ----
    if args.by_project:
        proj = {}
        for r in roots.values():
            key = r["cwd"] or "?"
            q = proj.get(key)
            if q is None:
                q = proj[key] = dict(cwd=key, title="", model=r["model"], turns=0, subs=0,
                                     first=None, last=None,
                                     tok={k: 0 for k in r["tok"]}, out={k: 0 for k in r["out"]},
                                     cost={k: 0.0 for k in r["cost"]}, nsess=0)
            q["nsess"] += 1
            q["turns"] += r["turns"]
            for k in q["tok"]:
                q["tok"][k] += r["tok"][k]
                q["out"][k] += r["out"][k]
                q["cost"][k] += r["cost"][k]
            if r["last"] and (q["last"] is None or r["last"] > q["last"]):
                q["last"] = r["last"]
        rows = list(proj.values())
    else:
        rows = list(roots.values())

    wkey = args.window  # one of 5h/24h/7d/total, all precomputed
    store = "cost" if args.api_cost else "tok"
    fmt = fmt_money if args.api_cost else fmt_tok

    if not args.all and win_s is not None:
        cut = now - timedelta(seconds=win_s)
        rows = [r for r in rows if r["last"] and r["last"] >= cut]
    rows.sort(key=lambda r: r[store][wkey], reverse=True)

    # ---- headline: real rate-limit meter ----
    print(f"Codex usage — {now.astimezone().strftime('%Y-%m-%d %H:%M %Z')}")
    if latest_rl:
        e, rl = latest_rl
        plan = rl.get("plan_type") or "?"
        prim = rl.get("primary") or {}
        sec = rl.get("secondary") or {}
        age = human_age(datetime.fromtimestamp(e, timezone.utc), now)
        print(f"plan: {plan}    (meter as of {age} ago)")
        if prim:
            print(f"  5-hour : {prim.get('used_percent',0):5.1f}% used  "
                  f"[{bar(prim.get('used_percent',0))}]  resets in {human_until(prim.get('resets_at'), now)}")
        if sec:
            wm = sec.get("window_minutes", 10080)
            label = "weekly " if wm >= 10080 else f"{int(wm/60)}h-win"
            print(f"  {label}: {sec.get('used_percent',0):5.1f}% used  "
                  f"[{bar(sec.get('used_percent',0))}]  resets in {human_until(sec.get('resets_at'), now)}")
    else:
        print("  (no rate-limit data found in session files)")
    print()

    metric = "est. API $" if args.api_cost else "tokens"
    scope = "all-time" if win_s is None else f"active in last {args.window}"
    print(f"per-{'project' if args.by_project else 'session'} {metric} — sorted by {wkey} — {len(rows)} {scope}")
    subcol = "SESS" if args.by_project else "SUBS"
    hdr = f"{'LAST':>5}  {'PROJECT':<22} {'TURNS':>5} {subcol:>4}  {'5h':>8} {'24h':>8} {'7d':>8} {'TOTAL':>9}  TITLE"
    print(hdr)
    print("-" * len(hdr))
    tot = {k: 0 for k in ("5h", "24h", "7d", "total")}
    for r in rows:
        for k in tot:
            tot[k] += r[store][k]
    for r in rows[: args.top]:
        proj = os.path.basename((r["cwd"] or "?").rstrip("/")) or "?"
        subs = r.get("subs", 0) if not args.by_project else r.get("nsess", 0)
        title = (r.get("title") or (r["id"][:8] if not args.by_project else "")) or ""
        print(f"{human_age(r['last'], now):>5}  {proj[:22]:<22} {r['turns']:>5} {subs:>4}  "
              f"{fmt(r[store]['5h']):>8} {fmt(r[store]['24h']):>8} {fmt(r[store]['7d']):>8} "
              f"{fmt(r[store]['total']):>9}  {title}")
    print("-" * len(hdr))
    print(f"{'ALL':>5}  {'('+str(len(rows))+(' projects' if args.by_project else ' sessions')+')':<22} {'':>5} {'':>4}  "
          f"{fmt(tot['5h']):>8} {fmt(tot['24h']):>8} {fmt(tot['7d']):>8} {fmt(tot['total']):>9}")
    print()
    print("The 5-hour / weekly %% are Codex's REAL account meter (read from the data, no calibration).")
    if args.api_cost:
        print("$ columns = what the usage WOULD cost at OpenAI API list prices (gpt-5.5: $5/$0.50/$30")
        print("per 1M in/cached/out). On a Codex subscription you are NOT billed this — it's an estimate")
        print("of the value. SUBS = subagent threads rolled into the parent.")
    else:
        print("Token columns are per-session totals (a proxy for which session drove that usage); SUBS =")
        print("subagent threads rolled into the parent. The account meter is global, so session tokens")
        print("explain the share, not the absolute %%.  (--api-cost shows USD at API rates instead.)")


if __name__ == "__main__":
    main()
